{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Encore",
  "version": "0.4.0",
  "identifier": "com.encore.clipper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Encore",
        "width": 1340,
        "height": 840,
        "minWidth": 1020,
        "minHeight": 660,
        "resizable": true,
        "backgroundColor": "#ecebf3"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob:; style-src 'self' 'unsafe-inline';",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Encore",
    "copyright": "Copyright (C) 2026 Encore Contributors (GPL-3.0)",
    "shortDescription": "Low-overhead Windows game clipping and multi-track replay studio",
    "longDescription": "Encore is a low-overhead Windows game clipping and multi-track replay studio built with Rust and Tauri 2.",
    "homepage": "https://github.com/yancelic/Encore",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../../tools/ffmpeg.exe": "ffmpeg.exe",
      "../../../target/release/encore-recorder.exe": "encore-recorder.exe"
    },
    "windows": {
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser"
      }
    }
  }
}
