# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Frontend / Node (apps/ui)
node_modules/
apps/ui/dist/
*.tsbuildinfo
npm-debug.log*

# Tauri generated schemas
apps/ui/src-tauri/gen/schemas/

# Bundled third-party tools (place ffmpeg.exe in tools/ locally; exceeds GitHub 100 MB limit)
tools/*.exe
tools/*.dll
tools/ffmpeg
tools/ffmpeg-libs/
packaging/flatpak/input/
.flatpak-builder/
__pycache__/

# Local test recordings & media outputs
*.mp4
*.mkv
*.m4a
*.wav

# Environment, local databases, logs, and OS files
.env
.env.*
*.log
*.db
*.sqlite
.DS_Store
Thumbs.db
desktop.ini

# Internal development handoff notes
HANDOFF.md

# Local UI snapshots and browser verification output
.local-backups/
apps/ui/test-results/
apps/ui/playwright-report/
